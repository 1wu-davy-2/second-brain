# ---------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------
# 留空 = 使用本地 PGlite（数据保存在 ./.data/pgdata，零配置）
# 生产填 Neon 连接串（Vercel 集成后会自动注入 DATABASE_URL）
# 注意：channel_binding 参数会被自动忽略，可保留也可删除
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------
# 认证（Auth.js v5）
# ---------------------------------------------------------------
# 生产必须设置：openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth：https://github.com/settings/developers
# 回调地址：https://<域名>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth：https://console.cloud.google.com/apis/credentials
# 回调地址：https://<域名>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------
# 默认管理员（仅 pnpm db:seed-admin 使用，不要配到 Vercel 运行时）
# ---------------------------------------------------------------
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_EMAIL=admin@secondbrain.local

# ---------------------------------------------------------------
# 开发便利项（生产自动失效，除非显式打开）
# ---------------------------------------------------------------
# AUTH_DEV_LOGIN=false
# AUTH_DEV_EMAIL=dev@secondbrain.local
# AUTH_DEV_NAME=魏工
